rules_version = '2';
// Regras do Firestore do Portal da Logística. Cole em Firebase Console → Firestore → Rules → Publicar.
//
// Perfis moram em usuarios/{email} (id = e-mail em minúsculas) com campo `perfil`:
//   "logistica" | "ti"   → editam (ignorar/reativar NF)
//   "leitor"             → só visualiza
//   (sem documento)      → sem acesso
// Só o perfil "ti" lê acoes_log (quem mexeu) e gerencia usuarios/ (tela "Usuários" do site).
// Sem documento em usuarios/ = SEM acesso (exceto os administradores iniciais em boot()).
service cloud.firestore {
  match /databases/{db}/documents {

    function logado() { return request.auth != null && request.auth.token.email != null; }
    function meuEmail() { return request.auth.token.email.lower(); }
    // administradores iniciais (entram como ti sem documento) — igual a BOOTSTRAP em portal-auth.js
    function boot() { return meuEmail() in ['v.tozeti@pharmaesthetics.com.br', 'm.milani@pharmaesthetics.com.br']; }
    function perfil() {
      return exists(/databases/$(db)/documents/usuarios/$(meuEmail()))
        ? get(/databases/$(db)/documents/usuarios/$(meuEmail())).data.perfil
        : (boot() ? 'ti' : 'nenhum');
    }
    function membro() { return logado() && perfil() in ['logistica', 'ti', 'leitor']; }
    function editor() { return logado() && perfil() in ['logistica', 'ti']; }

    match /usuarios/{email} {
      allow read: if logado() && (email == meuEmail() || perfil() == 'ti');
      // só o ti cadastra/altera/remove pessoas (pelo site); só aceita o campo `perfil`
      allow create, update: if logado() && perfil() == 'ti'
        && request.resource.data.keys().hasOnly(['perfil'])
        && request.resource.data.perfil in ['logistica', 'ti', 'leitor'];
      allow delete: if logado() && perfil() == 'ti';
    }

    // NFs ignoradas/tratadas — todo logado lê; só editor escreve
    match /acoes/{id} {
      allow read: if membro();
      allow create, update: if editor()
        && request.resource.data.keys().hasOnly(['tipo', 'motivo', 'nf', 'filial', 'em'])
        && request.resource.data.tipo in ['ignorada', 'tratada']
        && request.resource.data.em == request.time;
      allow delete: if editor();
    }

    // trilha de auditoria — só ti lê; editor só acrescenta, com o próprio e-mail; imutável
    match /acoes_log/{logId} {
      allow read: if logado() && perfil() == 'ti';
      allow create: if editor()
        && request.resource.data.por == meuEmail()
        && request.resource.data.em == request.time;
      allow update, delete: if false;
    }
  }
}
