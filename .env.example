# ───────────────────────────────────────────────────────────────────────────
# Portal da Logística — credenciais de ACESSO (template)
# ───────────────────────────────────────────────────────────────────────────
# Copie este arquivo para `.env` e preencha os valores reais.
# ⚠️ O `.env` NUNCA vai para o git (está no .gitignore). No deploy, cada uma
#    destas variáveis vira um GitHub Secret (Settings → Secrets and variables).
#
# São DOIS perfis de acesso, como na tela de login:
#   • TI        → 1 credencial COMPARTILHADA (o time de TI usa a mesma).
#   • Logística → USUÁRIOS CADASTRADOS (vários "usuario:senha", quem pode ver).
# Por enquanto ambos usam usuario=user / senha=senha (protótipo).

# Chave para ASSINAR o cookie de sessão. Gere uma aleatória e grande:
#   python -c "import secrets; print(secrets.token_hex(32))"
PORTAL_SECRET_KEY=troque-por-um-valor-aleatorio-grande

# Duração da sessão (horas) antes de exigir login de novo.
PORTAL_SESSAO_HORAS=12

# ── TI (1 credencial compartilhada) ─────────────────────────────────────────
PORTAL_TI_USUARIO=user
PORTAL_TI_SENHA=senha

# ── Logística (usuários cadastrados) ────────────────────────────────────────
# Lista "usuario:senha" separada por vírgula. Adicione um por pessoa.
# Ex.: PORTAL_LOGISTICA_USUARIOS=v.tozeti:umaSenha,m.milani:outraSenha
PORTAL_LOGISTICA_USUARIOS=user:senha

# ───────────────────────────────────────────────────────────────────────────
# COLETOR on-prem → Azure (coletor_azure.py) — a "ponte dos 2 mundos"
# ───────────────────────────────────────────────────────────────────────────
# O coletor roda dentro da rede (máquina do robô) e dá POST do estado das NFs
# para o endpoint /v1/portal/nfs do container ca-calculadora-frete na Azure.
# USER/SENHA têm que bater com as envs USER_ID/SENHA do CONTAINER (credencial
# compartilhada da API da calculadora — a mesma do /v1/volumetria).

# Host base do container (SEM o path). Confirme o FQDN do app antes de fixar.
# Ex.: https://<app>.<sufixo>.eastus.azurecontainerapps.io
PORTAL_AZURE_BASE=

# Credencial Basic (= USER_ID/SENHA do container da calculadora).
PORTAL_AZURE_USER=
PORTAL_AZURE_SENHA=

# Ajustes finos (opcionais; defaults abaixo).
PORTAL_AZURE_CHUNK=500      # NFs por POST (evita lote gigante/timeout)
PORTAL_AZURE_RPS=4          # POSTs por segundo (rate limit do container é 5/s)
PORTAL_AZURE_TIMEOUT=30     # segundos por request
# PORTAL_POLL_SEGUNDOS=20   # intervalo do ciclo NO MODO LOOP (não usado no --once)

# Modo de execução. Vazio = loop contínuo (serviço de pé). O run_coletor.bat já
# força PORTAL_ONESHOT=1 (1 ciclo e sai), então não precisa setar aqui p/ usar o
# .bat no Agendador de Tarefas de 15 em 15 min.
# PORTAL_ONESHOT=1
# PORTAL_COLETOR_ESTADO=estado_coletor.json  # cache de delta persistido entre runs
